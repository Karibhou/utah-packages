cmp: report IRM failures from iec61883_cmp_normalize_output

libiec61883-channel-allocation-without-local-node-rw.patch logs every
raw1394_channel_modify(RAW1394_MODIFY_ALLOC) failure at debug level and
returns 0, so callers treat a channel as allocated even when the IRM
could not be reached or refused the allocation.

On failure, read the IRM's CHANNELS_AVAILABLE register as the original
code did. A clear bit means the channel is in use already, which is
success; a failed read, or a channel still marked available, returns -1.
A successful allocation still needs no access to the IRM's device file.

--- libiec61883-1.2.0.orig/src/cmp.c
+++ libiec61883-1.2.0/src/cmp.c
@@ -963,6 +963,37 @@
 	return result;
 }
 
+/* After raw1394_channel_modify(ALLOC) failed, confirm with the IRM that the
+ * channel is in use already.  Return 0 when it is; return -1 when the IRM
+ * cannot be read or still reports the channel available, so the failure is
+ * not mistaken for a successful allocation. */
+static int
+channel_already_allocated (raw1394handle_t handle, unsigned int channel)
+{
+	nodeaddr_t addr = CSR_REGISTER_BASE;
+	unsigned int c = channel;
+	quadlet_t buffer;
+
+	if (c > 31 && c < 64) {
+		addr += CSR_CHANNELS_AVAILABLE_LO;
+		c -= 32;
+	} else if (c < 64)
+		addr += CSR_CHANNELS_AVAILABLE_HI;
+	else
+		FAIL ("Invalid channel %u", channel);
+	c = 31 - c;
+
+	if (iec61883_cooked_read (handle, raw1394_get_irm_id (handle), addr,
+		sizeof (quadlet_t), &buffer) < 0)
+		FAIL ("Failed to allocate channel %u: can't reach IRM", channel);
+
+	if ((ntohl (buffer) & (1U << c)) != 0)
+		FAIL ("Failed to allocate channel %u", channel);
+
+	DEBUG ("Channel %u already allocated", channel);
+	return 0;
+}
+
 int
 iec61883_cmp_normalize_output (raw1394handle_t handle, nodeid_t node)
 {
@@ -984,8 +1015,9 @@
 		if (iec61883_get_oPCRX (handle, node, &opcr, oplug) == 0
 		    && opcr.online
 		    && (opcr.n_p2p_connections > 0 || opcr.bcast_connection == 1)
-		    && raw1394_channel_modify (handle, opcr.channel, RAW1394_MODIFY_ALLOC) < 0)
-			DEBUG ("Channel %d already allocated, or can't reach IRM", opcr.channel);
+		    && raw1394_channel_modify (handle, opcr.channel, RAW1394_MODIFY_ALLOC) < 0
+		    && channel_already_allocated (handle, opcr.channel) < 0)
+			return -1;
 
 	return 0;
 }
